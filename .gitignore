node_modules/
.venv/
venv/
__pycache__/
*.py[cod]

# Keep source-managed research data explicit.
# Do not commit copyrighted scans, extracted book chapters, or bulk source dumps.
data/raw/
data/source-materials/
*.pdf
*.jpg
*.jpeg
*.png
*.tif
*.tiff
*.webp
